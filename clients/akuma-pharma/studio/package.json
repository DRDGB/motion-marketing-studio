{
  "name": "mms-studio-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Brand-token Remotion engine for motion-marketing-studio client workspaces.",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "demo:still": "remotion still src/index.ts DEMO ../renders/DEMO/demo.png --frame=60",
    "demo:render": "remotion render src/index.ts DEMO ../renders/DEMO/DEMO.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
